# ── AI ────────────────────────────────────────────────────────────────────────
# Server-side OpenAI key. Used for: (a) all AI features in local dev when
# accounts are not configured, (b) paid-tier users' quota-limited AI usage in
# production. Free-tier users bring their own key via the in-app dialog.
# Get yours at https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# ── Job search (optional — /api/search-jobs has no UI consumer yet) ──────────
# Register at https://developer.adzuna.com/
ADZUNA_APP_ID=your_adzuna_app_id
ADZUNA_APP_KEY=your_adzuna_app_key

# ── Accounts (Clerk) ──────────────────────────────────────────────────────────
# Optional: without these the app runs in "no accounts" mode — all templates
# free, AI via the server key or BYOK, no payments.
# Keys: https://dashboard.clerk.com → your app → API Keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/login

# ── Database (Supabase, shared project — "resume" schema) ────────────────────
# Database only (Clerk owns auth). All access is server-side with the
# new-style secret key; there are no browser Supabase queries. Setup:
#   1. Run supabase/migrations/0001_monetization.sql in the SQL editor.
#   2. Dashboard → Settings → API → "Exposed schemas": add "resume".
SUPABASE_URL=https://your-project.supabase.co
# New-style secret key (sb_secret_...), replaces the legacy service_role key.
# Server-only — NEVER expose to the browser.
SUPABASE_SECRET_KEY=sb_secret_...
# New-style publishable key (sb_publishable_..., replaces the legacy anon
# key). Not currently consumed — the app has no client-side Supabase access —
# kept here for future client features.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# ── Payments (Stripe) ─────────────────────────────────────────────────────────
# Optional: without these the paid-tier buttons show "payments not configured".
# Keys: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_...
# Webhook signing secret for the /api/stripe/webhook endpoint. Subscribe it to
# checkout.session.completed and checkout.session.async_payment_succeeded.
# Local testing: stripe listen --forward-to localhost:3000/api/stripe/webhook
STRIPE_WEBHOOK_SECRET=whsec_...

# ── Deployment ────────────────────────────────────────────────────────────────
# Optional canonical public origin (e.g. https://your-domain.com). Used to
# build Stripe success/cancel redirect URLs. Not needed on Vercel; set it when
# self-hosting behind a proxy that doesn't forward host/proto headers, or
# Stripe may redirect buyers to an internal address.
NEXT_PUBLIC_APP_URL=
